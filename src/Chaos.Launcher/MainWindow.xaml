<Window x:Class="Chaos.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chaos.Launcher"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Chaos Launcher" Width="960" Height="600"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="Panel" TargetType="local:Glass">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="Card" TargetType="local:Glass" BasedOn="{StaticResource Panel}">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Padding" Value="18,0,12,0" />
    </Style>
    <Style x:Key="Notes" TargetType="local:Glass" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Description under a setting. -->
    <Style x:Key="SettingNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Setting name, left of its card. -->
    <Style x:Key="SettingName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="130" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The PLAY button. -->
    <LinearGradientBrush x:Key="PlayBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#FF2B93F8" />
      <GradientStop Offset="0.55" Color="#FF1B72E8" />
      <GradientStop Offset="1" Color="#FF1355D2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayHoverBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#FF3A9DFA" />
      <GradientStop Offset="0.55" Color="#FF2A7DEE" />
      <GradientStop Offset="1" Color="#FF1F60DA" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayPressedBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#FF2387E8" />
      <GradientStop Offset="0.55" Color="#FF1666D6" />
      <GradientStop Offset="1" Color="#FF0F4BBE" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StripesBrush" StartPoint="0,0" EndPoint="16,0" MappingMode="Absolute" SpreadMethod="Repeat">
      <LinearGradientBrush.Transform>
        <RotateTransform Angle="-25" />
      </LinearGradientBrush.Transform>
      <GradientStop Offset="0" Color="#29FFFFFF" />
      <GradientStop Offset="0.5" Color="#29FFFFFF" />
      <GradientStop Offset="0.5" Color="#00FFFFFF" />
      <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <Style x:Key="PlayButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Shadow" CornerRadius="8" Background="#FF0A1A40" Margin="2,4,2,0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#FF000A28" Opacity="0.55" />
                </Border.Effect>
              </Border>
              <Border x:Name="Box" CornerRadius="8" Background="{StaticResource PlayBrush}" BorderBrush="#990A286E"
                      BorderThickness="1" />
              <Border x:Name="Stripes" CornerRadius="8" Background="{StaticResource StripesBrush}" Visibility="Collapsed" />
              <Border x:Name="Rim" CornerRadius="7" Margin="1" BorderBrush="#4DAADCFF" BorderThickness="1" />
              <local:TrackedText x:Name="Label" Text="{Binding PlayText}" Tracking="0.38"
                                 FontFamily="{StaticResource NumberFont}" FontSize="25" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                <local:TrackedText.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Color="#FF001E5A" Opacity="0.5" />
                </local:TrackedText.Effect>
              </local:TrackedText>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource PlayHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource PlayPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <DataTrigger Binding="{Binding Starting}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Stripes" Property="Visibility" Value="Visible" />
                <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Label" Property="Tracking" Value="0.3" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Running}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Box" Property="Background" Value="#12FFFFFF" />
                <Setter TargetName="Box" Property="BorderBrush" Value="#47A0C8FF" />
                <Setter TargetName="Rim" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Label" Property="Foreground" Value="#FF9FB2D8" />
                <Setter TargetName="Label" Property="Tracking" Value="0.2" />
                <Setter TargetName="Label" Property="Effect" Value="{x:Null}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" ClipToBounds="True">
    <Border x:Name="Fallback" Background="{StaticResource NavyBrush}" />
    <Rectangle x:Name="Slab" Opacity="0" />
    <Border Background="{StaticResource TintBrush}" />

    <Grid x:Name="Body">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <!-- Block mouse and keyboard under the prompt. -->
            <DataTrigger Binding="{Binding PromptShown}" Value="True">
              <Setter Property="IsEnabled" Value="False" />
              <Setter Property="Effect">
                <Setter.Value>
                  <BlurEffect Radius="2" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

        <TabItem Header="Play" Tag="{StaticResource PlayIcon}">
          <Grid>
            <StackPanel Margin="44,44,44,0" VerticalAlignment="Top">
              <local:Glass Style="{StaticResource Panel}" MinHeight="124" Padding="16,14,16,12">
                <StackPanel>
                  <TextBlock Text="Game folder" Style="{StaticResource Heading}" />
                  <DockPanel Margin="0,8,0,0">
                    <Button Content="Change…" DockPanel.Dock="Right" Width="104" Padding="0" Margin="12,0,0,0"
                            Click="Browse_Click" />
                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="6" Height="40" Padding="14,0">
                      <TextBlock Text="{Binding GameFolderText}" ToolTip="{Binding GameFolderText}" FontSize="13.5"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DockPanel>
                  <DockPanel Margin="0,10,0,0">
                    <Path DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                          <Setter Property="Data" Value="{StaticResource WarnIcon}" />
                          <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
                          <Setter Property="StrokeThickness" Value="1.4" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding GameReady}" Value="True">
                              <Setter Property="Data" Value="{StaticResource CheckIcon}" />
                              <Setter Property="Stroke" Value="{StaticResource GoodBrush}" />
                              <Setter Property="StrokeThickness" Value="1.8" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding GameStatusText}" TextWrapping="Wrap" FontSize="13.5"
                               Foreground="{StaticResource Ink2Brush}" />
                  </DockPanel>
                </StackPanel>
              </local:Glass>

              <Button Style="{StaticResource PlayButton}" IsEnabled="{Binding CanPlay}" Click="Play_Click"
                      Height="62" Margin="0,28,0,0" AutomationProperties.Name="{Binding PlayText}" />

              <!-- Fixed-height slot under PLAY. -->
              <Grid Height="65" Margin="0,16,0,0">
                <local:Glass VerticalAlignment="Top" Background="{StaticResource LightPanelBrush}"
                             BorderBrush="{StaticResource LightLineBrush}" BorderThickness="1" CornerRadius="8"
                             Padding="14,9,14,11"
                             Visibility="{Binding ShowPicturesMeter, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <TextBlock Text="{Binding PicturesText}" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource Bar}" Margin="0,10,0,0"
                                 Maximum="{Binding PicturesTotal, Mode=OneWay}" Value="{Binding PicturesDone, Mode=OneWay}" />
                  </StackPanel>
                </local:Glass>
                <local:Glass VerticalAlignment="Top" MinHeight="38" Padding="14,8" CornerRadius="8" BorderThickness="1"
                             Background="{StaticResource LightPanelBrush}" BorderBrush="{StaticResource LightLineBrush}"
                             Visibility="{Binding ShowPicturesLine, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource CheckIcon}" Stroke="{StaticResource GoodBrush}"
                          StrokeThickness="1.8" Width="16" Height="16" Margin="0,0,8,0"
                          Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding PicturesText}" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="480" VerticalAlignment="Center" />
                  </StackPanel>
                </local:Glass>
              </Grid>

              <local:Glass Style="{StaticResource Panel}" Margin="0,15,0,0" Padding="16,10">
                <TextBlock Style="{StaticResource NoteText}">No account yet? Go to <Hyperlink Click="AccountLink_Click">Account</Hyperlink>.</TextBlock>
              </local:Glass>

              <local:Glass Margin="0,12,0,0" Padding="16,10">
                <local:Glass.Style>
                  <Style TargetType="local:Glass" BasedOn="{StaticResource Panel}">
                    <Setter Property="BorderBrush" Value="#66FF8F9A" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PlayError}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:Glass.Style>
                <TextBlock Text="{Binding PlayError}" Style="{StaticResource NoteText}" Foreground="{StaticResource BadBrush}" />
              </local:Glass>
            </StackPanel>

            <!-- Update banner. -->
            <local:Glass VerticalAlignment="Bottom" Margin="44,0,44,14" Height="40" CornerRadius="6" BorderThickness="1"
                         Background="#6614468C" BorderBrush="#7349B6FF" Padding="14,0,4,0"
                         Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVisibility}}">
              <DockPanel>
                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource DownloadIcon}"
                      Stroke="{StaticResource BlueHiBrush}" Width="16" Height="16" Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Update now" Height="30"
                        Padding="14,0" FontSize="12.5" Click="UpdateNow_Click" />
                <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" />
              </DockPanel>
            </local:Glass>
            <local:Glass Style="{StaticResource Panel}" VerticalAlignment="Bottom" Margin="44,0,44,14" Height="40"
                         CornerRadius="6" Padding="14,0"
                         Visibility="{Binding ShowUpdatedNote, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource CheckIcon}" Stroke="{StaticResource GoodBrush}"
                      StrokeThickness="1.8" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding UpdatedNote}" VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}" />
              </StackPanel>
            </local:Glass>
          </Grid>
        </TabItem>

        <TabItem Header="Account" Tag="{StaticResource AccountIcon}">
          <StackPanel Margin="44,44,44,0">
            <Button Style="{StaticResource PrimaryButton}" Height="42" Padding="22,0" HorizontalAlignment="Left"
                    Click="Account_Click" AutomationProperties.Name="Sign in on the website">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sign in on the website" VerticalAlignment="Center" />
                <Path Style="{StaticResource Icon}" Data="{StaticResource ExternalIcon}" Stroke="#CCFFFFFF" StrokeThickness="1.3"
                      Width="12" Height="12" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </TabItem>

        <!-- Settings, one card each, grouped under headings. -->
        <TabItem x:Name="SettingsTab" Header="Settings" Tag="{StaticResource SettingsIcon}">
          <StackPanel Margin="44,58,44,0">
            <TextBlock Text="Display" Style="{StaticResource Heading}" />
            <local:Glass Style="{StaticResource Card}" Margin="0,7,0,0">
              <DockPanel>
                <TextBlock Text="Resolution" Style="{StaticResource SettingName}" />
                <ComboBox DockPanel.Dock="Right" Width="210" HorizontalAlignment="Right"
                          ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                          IsEnabled="{Binding CanChangeResolution}" TextSearch.TextPath="Label"
                          AutomationProperties.Name="Resolution">
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <Image Source="{StaticResource LevelStar}" Width="14" Height="14" Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Sharp, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Border />
              </DockPanel>
            </local:Glass>
            <local:Glass Style="{StaticResource Notes}" Margin="0,8,0,0"
                         Visibility="{Binding ShowSharpNote, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource SettingNote}">Resolutions with <InlineUIContainer BaselineAlignment="Center"><Image Source="{StaticResource LevelStar}" Width="15" Height="15" Margin="2,0" /></InlineUIContainer> are the most optimal.</TextBlock>
            </local:Glass>

            <TextBlock Text="Launcher" Style="{StaticResource Heading}" Margin="0,16,0,0" />
            <local:Glass Style="{StaticResource Card}" Margin="0,7,0,0">
              <DockPanel>
                <TextBlock Text="Version" Style="{StaticResource SettingName}" />
                <Button DockPanel.Dock="Right" Content="{Binding UpdateButtonText}" Height="36" FontSize="13"
                        IsEnabled="{Binding CanCheckUpdate}" Click="CheckUpdates_Click" />
                <TextBlock Text="{Binding VersionStateText}" Foreground="{StaticResource Ink2Brush}" FontSize="14"
                           VerticalAlignment="Center" />
              </DockPanel>
            </local:Glass>
          </StackPanel>
        </TabItem>
      </TabControl>

      <Image Source="pack://application:,,,/ChaosLauncher;component/Assets/Logo.png" Width="228"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,29,0,0" IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Chaos Launcher" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,124,0,0"
                  IsHitTestVisible="False">
        <TextBlock Text="Yu-Gi-Oh! Online" Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Margin="10,1,0,0" VerticalAlignment="Center">
          <StackPanel.Resources>
            <Style TargetType="Image">
              <Setter Property="Source" Value="{StaticResource LevelStar}" />
              <Setter Property="Width" Value="11" />
              <Setter Property="Height" Value="11" />
              <Setter Property="Margin" Value="0,0,2,0" />
            </Style>
          </StackPanel.Resources>
          <Image /><Image /><Image /><Image /><Image /><Image /><Image /><Image />
        </StackPanel>
      </StackPanel>

      <local:Glass Style="{StaticResource Panel}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="244"
                   Margin="14,0,0,14" Padding="16,12,16,12">
        <StackPanel>
          <Border HorizontalAlignment="Left" MinHeight="32" CornerRadius="16" Padding="12,0,4,0" Background="#1496BEFF"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#FF8A94A8" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ServerState}" Value="Online">
                        <Setter Property="Fill" Value="#FF3BE08F" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ServerState}" Value="Blocked">
                        <Setter Property="Fill" Value="#FFF5B547" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ServerState}" Value="Offline">
                        <Setter Property="Fill" Value="#FFF0596A" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                      Click="Refresh_Click" IsEnabled="{Binding CanCheck}"
                      ToolTip="Check the server again" AutomationProperties.Name="Check the server again">
                <Path Style="{StaticResource Icon}" Data="{StaticResource RefreshIcon}" StrokeThickness="1.4" Width="14" Height="14"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
              <TextBlock Text="{Binding ServerText}" Margin="9,6,0,7" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,11" />
          <TextBlock Foreground="{StaticResource Ink2Brush}" Margin="2,0,0,0">
            <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text="  ·  " /><Hyperlink Click="Project_Click">
              <Hyperlink.Style>
                <Style TargetType="Hyperlink" BasedOn="{StaticResource {x:Type Hyperlink}}">
                  <Setter Property="TextDecorations">
                    <Setter.Value>
                      <TextDecorationCollection>
                        <TextDecoration Location="Underline" PenOffset="1.5">
                          <TextDecoration.Pen>
                            <Pen Brush="#739AD2FF" Thickness="1" />
                          </TextDecoration.Pen>
                        </TextDecoration>
                      </TextDecorationCollection>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Hyperlink.Style>Project page</Hyperlink>
          </TextBlock>
        </StackPanel>
      </local:Glass>
    </Grid>

    <!-- Update prompt over the dimmed window. -->
    <Grid Visibility="{Binding PromptShown, Converter={StaticResource BoolToVisibility}}">
      <Border Background="#8C030714" />
      <Border Width="370" Height="234" CornerRadius="10" Background="#FF0A142E">
        <Border.Effect>
          <DropShadowEffect BlurRadius="60" ShadowDepth="24" Direction="270" Color="Black" Opacity="0.55" />
        </Border.Effect>
      </Border>
      <local:Glass Width="380" MinHeight="244" HorizontalAlignment="Center" VerticalAlignment="Center"
                   CornerRadius="10" BorderThickness="1" Background="#D60A142E" BorderBrush="#4296C3FF" Padding="28,26">
        <DockPanel>
          <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateStep}" Value="Downloading">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding UpdateStep}" Value="Failed">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button Style="{StaticResource PrimaryButton}" Content="Update now" Padding="22,0" Click="UpdateNow_Click" />
              <Button Content="Not now" Margin="10,0,0,0" Click="NotNow_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateStep}" Value="Downloading">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{Binding DownloadText}" Foreground="{StaticResource InkBrush}" />
              <ProgressBar Style="{StaticResource Bar}" Margin="0,10,0,0"
                           Maximum="{Binding DownloadTotal, Mode=OneWay}" Value="{Binding DownloadDone, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UpdateStep}" Value="Failed">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button Style="{StaticResource PrimaryButton}" Content="Open the release page" Padding="18,0" Click="ReleasePage_Click" />
              <Button Content="Close" Margin="10,0,0,0" Click="NotNow_Click" />
            </StackPanel>
          </Grid>
          <StackPanel>
            <TextBlock Text="{Binding PromptTitle}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
            <TextBlock Text="{Binding PromptText}" Margin="0,10,0,0" FontSize="13.5" LineHeight="21"
                       LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </local:Glass>
    </Grid>

    <!-- Window rim when Windows draws none. -->
    <Border x:Name="Rim" BorderBrush="#29FFFFFF" BorderThickness="1" IsHitTestVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
        <Path Data="{StaticResource MinimizeIcon}" StrokeThickness="1" Width="10" Height="10"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
        <Path Data="{StaticResource CloseIcon}" StrokeThickness="1" Width="10" Height="10"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
