<UserControl x:Class="Chaos.Launcher.LpMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Chaos.Launcher">
  <!-- A light line of glass: gold LP, what is left in counter digits and the status on one
       baseline, and under them the gauge, draining as what is left comes down. -->
  <local:Glass Background="{StaticResource LightPanelBrush}" BorderBrush="{StaticResource LightLineBrush}"
               BorderThickness="1" CornerRadius="8" Padding="14,9,14,11">
    <StackPanel>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock Text="LP" FontFamily="{StaticResource NumberFont}" FontSize="15" Foreground="{StaticResource GoldBrush}"
                     VerticalAlignment="Bottom" Margin="0,0,10,-3" />
          <local:SegmentDisplay x:Name="Digits" DigitHeight="24" Fill="{StaticResource BlueHiBrush}" VerticalAlignment="Bottom"
                                Margin="0,0,0,2" />
          <TextBlock x:Name="UnitText" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="#FFA9CDF2"
                     VerticalAlignment="Bottom" Margin="7,0,0,-1" />
        </StackPanel>
        <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Margin="12,0,0,-1" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Grid x:Name="Gauge" Height="6" Margin="0,11,0,0">
        <Border CornerRadius="3" Background="#66000000" BorderBrush="#2996C3FF" BorderThickness="1" />
        <Border x:Name="Level" CornerRadius="3" HorizontalAlignment="Left" Width="0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Offset="0" Color="#FF1C78F0" />
              <GradientStop Offset="1" Color="#FF6FD0FF" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Grid>
    </StackPanel>
  </local:Glass>
</UserControl>
